server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;
  # Les fichiers qui changent à chaque version ne doivent pas rester en cache
  location = /index.html            { add_header Cache-Control "no-store"; }
  location = /flutter_service_worker.js { add_header Cache-Control "no-store"; }
  location = /main.dart.js          { add_header Cache-Control "no-cache"; }
  location = /flutter_bootstrap.js  { add_header Cache-Control "no-cache"; }
  location / { try_files $uri $uri/ /index.html; }
}
