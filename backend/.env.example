# ═══════════════════════════════════════════════════════════════════════════
#  .env.example — modèle du fichier .env du backend Asoukaa
#
#  Copiez ce fichier en ".env" (même dossier) puis remplissez les valeurs.
#  ⚠️ Ne mettez JAMAIS de vraies valeurs ici : ce fichier est un modèle public.
#  ⚠️ Le fichier .env lui-même ne doit jamais être partagé ni envoyé.
#  Le serveur vérifie ce fichier au démarrage (src/config/env.validation.ts) :
#  en PRODUCTION une configuration invalide empêche le démarrage ; en
#  développement le serveur démarre mais affiche un avertissement.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────────────
# development | production
NODE_ENV=development
# recommandé : heure du Bénin (dates cohérentes serveur / base)
TZ=Africa/Lagos
APP_PORT=3000
# injecté automatiquement par l'hébergeur (Railway...) : ne pas définir à la main
# PORT=

# URL publique de CE serveur, sans slash final. Sert aux liens envoyés par e-mail
# (ex. « Ce n'est pas moi » du changement d'e-mail) et aux URL de fichiers en
# stockage local. ⚠️ EN PRODUCTION : obligatoire et en https://
APP_URL=http://localhost:3000

# Adresse du site web / back-office (CORS strict en production)
FRONTEND_WEB_URL=http://localhost:3001

# ─── Base de données PostgreSQL ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# false (ou absent) = la base évolue UNIQUEMENT par migrations (npm run typeorm:run).
# true = TypeORM modifie la base à chaque démarrage pour la faire ressembler aux
# entités et SUPPRIME les index/colonnes créés seulement par migration.
# ⛔ INTERDIT en production : le serveur refuse de démarrer si NODE_ENV=production
#    et DB_SYNCHRONIZE=true. En développement : avertissement au démarrage.
DB_SYNCHRONIZE=false
# true = affiche toutes les requêtes SQL
DB_LOGGING=false
# certificat racine du Postgres managé (production), pour vérifier le TLS
# DB_SSL_CA=

# ─── Sécurité : jetons de connexion (JWT) ──────────────────────────────────
# Deux secrets DIFFÉRENTS, longs (32 caractères minimum) et aléatoires.
# Pour en générer un :  npm run generate:key
JWT_SECRET=
# durée du jeton d'accès
JWT_EXPIRES_IN=15m
# ≠ JWT_SECRET
JWT_REFRESH_SECRET=
# durée du jeton de rafraîchissement
JWT_REFRESH_EXPIRES_IN=30d

# ─── Sécurité : chiffrement des coordonnées de paiement des vendeurs ───────
# EXACTEMENT 64 caractères hexadécimaux (0-9, a-f) = 32 octets.
# Générer une clé valide :  npm run generate:key
#   (équivalent : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ⚠️ Une fois des données chiffrées, NE PLUS CHANGER cette clé (elles deviendraient
#    illisibles) et la sauvegarder dans un endroit sûr, à part.
ENCRYPTION_KEY=

# ─── E-mails (SMTP) ────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
# true pour le port 465
MAIL_SECURE=false
MAIL_USER=
# ⚠️ s'appelle bien MAIL_PASSWORD (et non MAIL_PASS)
MAIL_PASSWORD=
MAIL_FROM="Asoukaa <no-reply@exemple.com>"
# Adresse de l'équipe qui reçoit les alertes (tickets de support, « Ce n'est pas moi »...)
SUPPORT_TEAM_EMAIL=

# ─── Fichiers envoyés (images, documents, vidéos) ──────────────────────────
# supabase | local (local = disque du serveur, développement seulement)
STORAGE_DRIVER=supabase
SUPABASE_URL=
# clé « service_role » : jamais la clé anon/publique
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=asoukaa-public
SUPABASE_PRIVATE_BUCKET=asoukaa-private
# octets : images et PDF (5 Mo)
MAX_FILE_SIZE=5242880
# octets : vidéo de présentation produit (50 Mo)
MAX_VIDEO_FILE_SIZE=52428800
# Livres numériques (PDF), en octets : 50 Mo par défaut. Le plan Supabase doit accepter des fichiers de cette taille.
MAX_EBOOK_FILE_SIZE=52428800
# nombre de fichiers qu'un utilisateur peut envoyer par heure
UPLOAD_MAX_PER_HOUR=60
# idem pour un compte administrateur
UPLOAD_ADMIN_MAX_PER_HOUR=300

# ─── Paiement FeexPay (mobile money) ───────────────────────────────────────
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
# valeur par défaut si absente
# FEEXPAY_BASE_URL=https://api-v2.feexpay.me
# valeur par défaut si absente
# FEEXPAY_MERCHANT_DOMAIN=asoukaa.com
# facultatif : secret du webhook FeexPay (à choisir : longue chaîne aléatoire). S'il est défini,
# l'appel doit le fournir (en-tête x-feexpay-secret ou ?token=<secret> dans l'adresse).
# FEEXPAY_WEBHOOK_SECRET=

# ─── Rappels de commandes non confirmées par le vendeur ────────────────────
# rappel au vendeur après N heures (défaut 24)
# ORDER_REMINDER_HOURS=24
# alerte aux admins après N heures (défaut 48)
# ORDER_ADMIN_ALERT_HOURS=48
# ─── Sites autorisés à appeler l'API depuis un navigateur (CORS) ───────────
# facultatif : adresses supplémentaires séparées par des virgules, en plus de
# FRONTEND_WEB_URL (ex. la version web de l'appli : https://test.asoukaa.com)
# CORS_EXTRA_ORIGINS=
