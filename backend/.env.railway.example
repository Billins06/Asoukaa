    # ═══════════════════════════════════════════════════════════════════════════
    #  Variables à saisir dans Railway (service backend > onglet « Variables »)
    #  ⚠️ Ce fichier est un MODÈLE : ne mets ici aucune vraie valeur secrète.
    #  Les lignes ${{Postgres.XXX}} sont des références Railway : copie-les telles quelles.
    # ═══════════════════════════════════════════════════════════════════════════
    NODE_ENV=production
    TZ=Africa/Lagos

    # Adresse publique du backend (HTTPS obligatoire en production)
    APP_URL=https://api-test.asoukaa.com
    # Version web de l'appli (celle de ton collègue iPhone)
    FRONTEND_WEB_URL=https://test.asoukaa.com
    # Autres sites qui appellent l'API depuis un navigateur (facultatif)
    # CORS_EXTRA_ORIGINS=https://dashboard-test.asoukaa.com

    # Base de données = le service PostgreSQL de Railway (nommé « Postgres »)
    DB_HOST=${{Postgres.PGHOST}}
    DB_PORT=${{Postgres.PGPORT}}
    DB_USER=${{Postgres.PGUSER}}
    DB_PASSWORD=${{Postgres.PGPASSWORD}}
    DB_NAME=${{Postgres.PGDATABASE}}
    DB_SYNCHRONIZE=false

    # Secrets : génère-en de NOUVEAUX pour le serveur de test (npm run generate:key, un par ligne)
    JWT_SECRET=
    JWT_REFRESH_SECRET=
    JWT_EXPIRES_IN=15m
    JWT_REFRESH_EXPIRES_IN=30d
    ENCRYPTION_KEY=

    # E-mails (mêmes réglages que chez toi)
    MAIL_HOST=
    MAIL_PORT=587
    MAIL_SECURE=false
    MAIL_USER=
    MAIL_PASSWORD=
    MAIL_FROM="Asoukaa <no-reply@asoukaa.com>"
    # Sur Railway le SMTP est souvent bloque : utilise l API Resend (HTTPS). Si cette cle est remplie,
    # elle remplace le SMTP ci-dessus. MAIL_FROM doit etre une adresse de ton domaine verifie chez Resend.
    RESEND_API_KEY=
    SUPPORT_TEAM_EMAIL=

    # Fichiers : Supabase (comme en développement) — recopie les valeurs de ton .env local
    STORAGE_DRIVER=supabase
    SUPABASE_URL=
    SUPABASE_SERVICE_ROLE_KEY=
    SUPABASE_PUBLIC_BUCKET=asoukaa-public
    SUPABASE_PRIVATE_BUCKET=asoukaa-private

    # Paiement FeexPay
    FEEXPAY_API_KEY=
    FEEXPAY_SHOP_ID=
    FEEXPAY_BASE_URL=https://api-v2.feexpay.me
    FEEXPAY_MERCHANT_DOMAIN=asoukaa.com
    FEEXPAY_WEBHOOK_SECRET=
