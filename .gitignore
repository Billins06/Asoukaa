# Sensitive environment files — never commit credentials
env.json
.env
.env.local
.env.*.local

# Clés de signature Android — un keystore commité + son mot de passe permet
# de signer un APK malveillant accepté comme mise à jour officielle.
*.keystore
*.jks
key.properties
android/key.properties
android/app/keystore/

# Réglages locaux Claude Code (contiennent des chemins et commandes machine)
.claude/settings.local.json

# Fichiers de sauvegarde d'édition (*.dart.bak_qa1, etc.)
*.bak
*.bak_*

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
pubspec.lock

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/web/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
android/app/.cxx

*.bat

# Dossier de sauvegardes QA locales
_sauvegardes_qa/
